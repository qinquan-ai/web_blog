---
import Base from "../ui/layouts/Base.astro";
import Button from "../ui/components/Button/Button.astro";

const IDEAS = [
  {
    title: "App Director — 可编排的产品演示视频工作流",
    slug: "app-director",
    type: "产品实验",
    stage: "原型验证",
    stageColor: "var(--accent)",
    desc: "把真实或高还原的软件界面组织成可编排的视频场景，用统一时间线控制倾斜、运镜、聚焦、高光和字幕。目前正以 BossHelper 与 TraceLink 两支演示作为原型样本。",
    highlights: [
      "React / HTML 高还原界面作为可控视频场景",
      "Remotion 统一帧时钟、镜头、高光与字幕",
      "HyperFrames 处理网页片段与组件级微调",
      "验证同一套镜头脚本能否迁移到不同软件演示",
    ],
  },
  {
    title: "TraceLink — 开发期全栈与 AI Agent 链路追踪",
    slug: "tracelink-observability",
    type: "开源开发工具",
    stage: "公开维护中",
    stageColor: "#16a34a",
    desc: "用于本地开发期追踪真实请求、工作流和 AI Agent 的运行路径。JavaScript 与 Python SDK 遵循同一份数据协议，并由本地 Receiver 和 Dashboard 汇总展示。",
    highlights: [
      "JavaScript / Python SDK 共享 TraceLog 协议",
      "NDJSON 落盘、SSE 实时推送与 Scope 控制",
      "日志、实时调用图、链路导图与时间线看板",
      "追踪组件故障时不改变被调试应用的行为",
    ],
  },
  {
    title: "BossHelper — 连接真实浏览器的岗位信息助手",
    slug: "boss-helper",
    type: "开源浏览器工具",
    stage: "已发布 · 维护中",
    stageColor: "#0f766e",
    desc: "通过 Chrome DevTools Protocol 连接用户已经打开的 Chrome 或 Edge，读取页面中已经渲染的岗位卡片，为个人研究和求职信息整理提供本地 GUI 与 CLI。",
    highlights: [
      "复用用户自己的浏览器会话，不直接请求平台接口",
      "从 DOM 与 Vue 组件树读取已经呈现的数据",
      "FastAPI 本地服务与 Vue 3 可视化界面",
      "保留 CLI、频率控制与本地导出能力",
    ],
  },
];
---

<Base
  title="产品实验室"
  description="这里维护和验证的软件产品；你的兴趣登记会帮助判断下一步投入。"
>
  <div class="ideas-page">
    <div class="container container--wide">
      <header class="page-header">
        <h1 class="page-title">产品实验室</h1>
        <p class="page-desc text-secondary">
          这里放已经公开维护的工具，也放正在验证的产品原型。兴趣登记不是预售，
          它会帮助我判断文档、演示和下一轮开发应该优先投入在哪里。
        </p>
      </header>

      <!-- PC 端为横向手风琴，手机端自动转换为纵向折叠手风琴 -->
      <div class="ideas-grid">
        {
          IDEAS.map((idea, index) => (
            <div
              class={`idea-card ${index === 0 ? "active" : ""}`}
              data-slug={idea.slug}
              style={`--stage-color: ${idea.stageColor}`}
            >
              <div class="collapsed-preview">
                <span class="vertical-tag">{idea.type}</span>
                <h2 class="vertical-title">{idea.title}</h2>
                <div class="vertical-heart">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="heart-icon"
                  >
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                  </svg>
                  <span id={`collapsed-count-${idea.slug}`}>0</span>
                </div>
              </div>

              <div class="expanded-content">
                <div class="card-header">
                  <span class="type-tag">{idea.type}</span>
                  <span class="stage-badge">
                    <span class="stage-dot" />
                    {idea.stage}
                  </span>
                </div>

                <h2 class="idea-title">{idea.title}</h2>
                <p class="idea-desc">{idea.desc}</p>

                <div class="idea-highlights">
                  <h3 class="highlights-title">核心内容/特色</h3>
                  <ul>
                    {idea.highlights.map(hl => (
                      <li>
                        <span class="bullet-check">✓</span>
                        {hl}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="card-footer">
                  <div class="interest-stats">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      class="heart-icon"
                    >
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                    </svg>
                    <span>
                      已有{" "}
                      <strong class="count-value" id={`count-${idea.slug}`}>
                        0
                      </strong>{" "}
                      人感兴趣
                    </span>
                  </div>

                  <form class="idea-form" action="#">
                    <div class="input-group">
                      <input
                        type="email"
                        class="idea-email-input"
                        placeholder="留下邮箱，当项目有进展或发布时通知你..."
                        required
                      />
                      <Button type="submit" class="idea-submit-btn" size="md">
                        我感兴趣
                      </Button>
                    </div>
                  </form>

                  <div class="idea-success-msg" style="display: none;">
                    <span class="success-icon">✓</span>{" "}
                    登记成功！感谢你的支持与关注。
                  </div>
                  <div class="idea-error-msg" style="display: none;" />
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p class="privacy-note text-tertiary">
        * 邮箱仅用于对应项目的重要进展通知，不会出售或提供给第三方。
      </p>
    </div>
  </div>
</Base>

<script>
  import { supabase } from "../lib/supabase";

  async function initIdeas() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(
        ".idea-card:not([data-initialized])"
      )
    );
    if (!cards.length) return;

    cards.forEach(card => {
      card.dataset.initialized = "true";
    });

    // 1. Bind Card Expanding Click Handler
    cards.forEach(card => {
      card.addEventListener("click", () => {
        if (card.classList.contains("active")) return;
        cards.forEach(c => c.classList.remove("active"));
        card.classList.add("active");
      });
    });

    // 2. Fetch and initialize counts & forms
    cards.forEach(async card => {
      const slug = card.dataset.slug;
      if (!slug) return;

      const countEl = document.getElementById(`count-${slug}`);
      const collCountEl = document.getElementById(`collapsed-count-${slug}`);
      const form = card.querySelector(".idea-form") as HTMLFormElement;
      const emailInput = card.querySelector(
        ".idea-email-input"
      ) as HTMLInputElement;
      const submitBtn = card.querySelector(
        ".idea-submit-btn"
      ) as HTMLButtonElement;
      const successEl = card.querySelector(".idea-success-msg") as HTMLElement;
      const errorEl = card.querySelector(".idea-error-msg") as HTMLElement;

      // Fetch count from Supabase
      if (import.meta.env.PUBLIC_SUPABASE_URL) {
        try {
          const { count, error } = await supabase
            .from("idea_interests")
            .select("*", { count: "exact", head: true })
            .eq("idea_slug", slug);

          if (!error && count !== null) {
            if (countEl) countEl.innerText = count.toString();
            if (collCountEl) collCountEl.innerText = count.toString();
          }
        } catch (e) {
          // eslint-disable-next-line no-console
          console.error("获取想法兴趣数失败:", e);
        }
      }

      // Check local storage for subscription status
      const isSubscribedLocal = localStorage.getItem(`subscribed_${slug}`);
      if (isSubscribedLocal) {
        if (form) form.style.display = "none";
        if (successEl) successEl.style.display = "block";
      }

      // Form submission
      form?.addEventListener("submit", async e => {
        e.preventDefault();
        e.stopPropagation(); // prevent card re-click bubble
        const email = emailInput.value.trim();
        if (!email) return;

        submitBtn.disabled = true;
        const originalText = submitBtn.innerText;
        submitBtn.innerText = "登记中...";
        if (errorEl) errorEl.style.display = "none";

        try {
          const { error } = await supabase
            .from("idea_interests")
            .insert({ idea_slug: slug, email: email });

          if (error) {
            if (error.code === "23505") {
              if (successEl) {
                successEl.innerHTML =
                  '<span class="success-icon">✓</span> 你已经登记过该想法的兴趣啦，谢谢支持！';
                successEl.style.display = "block";
              }
              if (form) form.style.display = "none";
              localStorage.setItem(`subscribed_${slug}`, "true");
            } else {
              throw error;
            }
          } else {
            // Success
            if (successEl) successEl.style.display = "block";
            if (form) form.style.display = "none";

            // Increment local displays
            const newVal = (
              (parseInt(countEl?.innerText || "0") || 0) + 1
            ).toString();
            if (countEl) countEl.innerText = newVal;
            if (collCountEl) collCountEl.innerText = newVal;

            localStorage.setItem(`subscribed_${slug}`, "true");
          }
        } catch (err) {
          // eslint-disable-next-line no-console
          console.error("提交登记失败:", err);
          if (errorEl) {
            const msg =
              err instanceof Error ? err.message : "登记失败，请稍后重试。";
            errorEl.innerText = msg;
            errorEl.style.display = "block";
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = originalText;
        }
      });
    });
  }

  // Handle page transitions in Astro
  document.addEventListener("astro:page-load", initIdeas);
  if (document.readyState !== "loading") {
    initIdeas();
  }
</script>

<style>
  .ideas-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  /* --- PC 端手风琴网格 --- */
  .ideas-grid {
    display: flex;
    gap: var(--space-4);
    width: 100%;
    height: 520px;
    align-items: stretch;
    margin-top: var(--space-6);
  }

  /* --- 想法卡片基础样式 (苹果微缝克制风) --- */
  .idea-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--stage-color) !important;
    background: var(--bg-primary);
    transition:
      flex 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      background-color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* --- 收缩态 (Collapsed Panels) --- */
  .idea-card {
    flex: 0.8;
    cursor: pointer;
    padding: var(--space-5) var(--space-2);
    justify-content: space-between;
    align-items: center;
  }

  .idea-card:hover:not(.active) {
    border-color: var(--border);
    background: var(--bg-secondary);
    box-shadow: var(--shadow-sm);
  }

  /* --- 展开态 (Active Panel) --- */
  .idea-card.active {
    flex: 5.5;
    cursor: default;
    padding: var(--space-6);
    justify-content: flex-start;
    align-items: stretch;
    border-color: var(--border);
    box-shadow: var(--shadow-md);
    background: var(--bg-primary);
  }

  /* ============================================
     收缩与展开内容的显示/隐藏与动画控制
     ============================================ */

  /* 折叠预览区 */
  .collapsed-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.25s var(--ease-out),
      visibility 0.25s;
  }

  .active .collapsed-preview {
    opacity: 0;
    visibility: hidden;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    padding: 0;
    margin: 0;
  }

  /* 展开内容区 */
  .expanded-content {
    opacity: 0;
    visibility: hidden;
    height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex: 1;
    transition:
      opacity 0.3s var(--ease-out),
      visibility 0.3s;
  }

  .active .expanded-content {
    opacity: 1;
    visibility: visible;
    height: auto;
    transition-delay: 0.2s; /* 延迟让卡片先横向撑开 */
  }

  /* ============================================
     折叠预览内容排版 (CJK 竖排)
     ============================================ */
  .vertical-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    writing-mode: vertical-rl;
  }

  .vertical-title {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.2em;
    text-align: center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-height: 300px;
    margin: var(--space-3) 0;
    line-height: 1.4;
  }

  .vertical-heart {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  /* ============================================
     展开内容排版
     ============================================ */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .type-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stage-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--stage-color);
    background: color-mix(in srgb, var(--stage-color) 8%, transparent);
    padding: 2px 10px;
    border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--stage-color) 15%, transparent);
  }

  .stage-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--stage-color);
  }

  .idea-title {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    line-height: 1.3;
  }

  .idea-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  /* 特色列表 */
  .idea-highlights {
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: auto; /* 将 card-footer 推到底部 */
  }

  .highlights-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .idea-highlights ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .idea-highlights li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 0;
  }

  .bullet-check {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  /* 底部表单区域 */
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-light);
    margin-top: var(--space-4);
  }

  .interest-stats {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .heart-icon {
    color: #ef4444;
    fill: color-mix(in srgb, #ef4444 12%, transparent);
  }

  .idea-form {
    width: 100%;
  }

  .input-group {
    display: flex;
    gap: var(--space-2);
    width: 100%;
  }

  .idea-email-input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: 999px; /* 使用 999px 完美药丸圆角，对齐 Button */
    padding: 8px 18px; /* 微调内边距使其高度与 md Button 完美对齐 */
    outline: none;
    transition: all var(--duration-fast);
  }

  .idea-email-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.08);
  }

  /* 提交按钮容器（复用了通用 Button，这里只需控制它不要被压缩即可） */
  :global(.idea-submit-btn) {
    flex-shrink: 0;
  }

  /* 状态反馈提示 */
  .idea-success-msg {
    font-size: 0.875rem;
    color: #065f46;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 10px var(--space-4);
    border-radius: var(--radius-md);
    animation: fadeIn 0.3s var(--ease-out);
  }

  [data-theme="dark"] .idea-success-msg {
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.12);
  }

  .success-icon {
    font-weight: 700;
    margin-right: 4px;
  }

  .idea-error-msg {
    font-size: 0.875rem;
    color: #b45309;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 10px var(--space-4);
    border-radius: var(--radius-md);
  }

  [data-theme="dark"] .idea-error-msg {
    color: #fcd34d;
    background: rgba(245, 158, 11, 0.12);
  }

  .privacy-note {
    font-size: 0.75rem;
    text-align: center;
    margin-top: var(--space-6);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============================================
     移动端响应式布局 (纵向折叠手风琴)
     ============================================ */
  @media (max-width: 768px) {
    .ideas-grid {
      flex-direction: column;
      height: auto;
      gap: var(--space-3);
    }

    /* 移动端卡片基础 */
    .idea-card {
      flex: none !important;
      width: 100%;
      height: 80px;
      min-height: 80px;
      padding: var(--space-3) var(--space-4);
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      border-left: 4px solid var(--stage-color) !important;
    }

    /* 移动端展开状态 */
    .idea-card.active {
      height: auto;
      min-height: 440px;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: var(--space-5);
    }

    /* 折叠预览 (水平排版，隐藏竖排标题) */
    .collapsed-preview {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
    }

    .vertical-tag {
      writing-mode: horizontal-tb;
    }

    .vertical-title {
      writing-mode: horizontal-tb;
      font-size: 0.9375rem;
      max-height: unset;
      margin: 0;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
      max-width: 60%;
      letter-spacing: normal;
    }

    .vertical-heart {
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    /* 展开细节 */
    .active .expanded-content {
      height: auto;
      opacity: 1;
      visibility: visible;
      transition-delay: 0.1s;
    }

    .idea-title {
      font-size: 1.25rem;
    }

    .input-group {
      flex-direction: column;
      gap: var(--space-2);
    }

    .idea-submit-btn {
      width: 100%;
    }
  }
</style>
