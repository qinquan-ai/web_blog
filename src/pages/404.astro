---
import Base from "../layouts/Base.astro";
---

<Base title="404 — 页面不存在">
  <div class="not-found">
    <div class="container">
      <div class="not-found-content">
        <div class="not-found-code font-mono">404</div>
        <h1 class="not-found-title">页面不存在</h1>
        <p class="not-found-desc text-secondary">
          你可能迷路了。这个页面已经消失，或者从未存在。
        </p>
        <div class="not-found-actions">
          <a href="/" class="btn-primary">返回首页</a>
          <a href="/blog" class="btn-secondary">阅读文章</a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .not-found {
    min-height: calc(100vh - 60px - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-content {
    text-align: center;
    padding: var(--space-9) 0;
  }

  .not-found-code {
    font-size: 6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--border);
    line-height: 1;
    margin-bottom: var(--space-5);
  }

  .not-found-title {
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .not-found-desc {
    font-size: 1rem;
    max-width: 360px;
    margin: 0 auto var(--space-7);
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  /* btn-primary, btn-secondary now in global.css */
</style>
