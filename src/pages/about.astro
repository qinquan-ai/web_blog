---
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE } from "../lib/config";
---

<Base title="关于" description="关于 Qin — 独立AI实践者的技术笔记本">
  <div class="about-page">
    <div class="container">
      <div class="about-grid">
        <!-- Left: identity -->
        <div class="about-identity">
          <div class="avatar-wrap">
            <div class="avatar">{SITE.title.charAt(0)}</div>
          </div>
          <h1 class="about-name">{SITE.title}</h1>
          <p class="about-tagline text-secondary">
            Freelancer · 全栈开发 · AI 应用
          </p>

          <SocialLinks variant="full" />
        </div>

        <!-- Right: content -->
        <div class="about-content">
          <section class="about-section">
            <h2>关于这个博客</h2>
            <p>
              内容来自实际工作，会写AI实践、架构踩坑、偶尔也有非AI的技术内容。
            </p>
            <p>如果某篇对你有用，就是我最大的满足。</p>
          </section>

          <section class="about-section">
            <h2>技术栈</h2>
            <div class="skill-grid">
              <div class="skill-group">
                <h3 class="skill-group-title">主战语言</h3>
                <div class="skill-tags">
                  <span class="skill-tag">TypeScript</span>
                  <span class="skill-tag">Python</span>
                  <span class="skill-tag">Go</span>
                  <span class="skill-tag">Rust</span>
                </div>
              </div>
              <div class="skill-group">
                <h3 class="skill-group-title">AI 基础设施</h3>
                <div class="skill-tags">
                  <span class="skill-tag">AI Proxy</span>
                  <span class="skill-tag">Gemini API</span>
                  <span class="skill-tag">Cursor / Cline</span>
                  <span class="skill-tag">Tauri</span>
                </div>
              </div>
              <div class="skill-group">
                <h3 class="skill-group-title">架构</h3>
                <div class="skill-tags">
                  <span class="skill-tag">CQRS</span>
                  <span class="skill-tag">Celery + Redis</span>
                  <span class="skill-tag">WebSocket</span>
                  <span class="skill-tag">TCC 分布式事务</span>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-9);
    align-items: start;
  }

  /* --- Identity --- */
  .about-identity {
    position: sticky;
    top: 80px;
  }

  .avatar-wrap {
    margin-bottom: var(--space-4);
  }

  .avatar {
    width: 72px;
    height: 72px;
    background: var(--text-primary);
    color: var(--bg-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .about-name {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }

  .about-tagline {
    font-size: 0.9375rem;
    margin-bottom: var(--space-5);
  }

  /* --- Content --- */
  .about-section {
    margin-bottom: var(--space-7);
  }
  .about-section:last-child {
    margin-bottom: 0;
  }

  .about-section h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .about-section p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* --- Skills --- */
  .skill-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-group-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-tag {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    padding: 4px 10px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .about-identity {
      position: static;
    }
  }
</style>
