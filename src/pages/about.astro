---
import Base from "../ui/layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE } from "../lib/config";
---

<Base title="关于" description="关于覃权 / Qin Quan — 独立产品工程师">
  <div class="about-page">
    <div class="container">
      <div class="about-grid">
        <!-- Left: identity -->
        <div class="about-identity">
          <div class="avatar-wrap">
            <div class="avatar">{SITE.logoMark ?? SITE.title.charAt(0)}</div>
          </div>
          <h1 class="about-name">{SITE.title}</h1>
          <p class="about-tagline text-secondary">
            独立产品工程师 · 开源工具 · 软件交付
          </p>

          <SocialLinks variant="full" />
        </div>

        <!-- Right: content -->
        <div class="about-content">
          <section class="about-section">
            <h2>关于这个博客</h2>
            <p>
              我是覃权（Qin Quan）。这里记录真实软件怎样从能跑的 Demo，
              变成能交付、能维护、能被别人安装和使用的产品。
            </p>
            <p>
              内容主要来自开源工具、商业交付、浏览器自动化和产品演示工作流。
              我会尽量把选择、边界和走过的弯路写清楚。
            </p>
          </section>

          <section class="about-section">
            <h2>技术栈</h2>
            <div class="skill-grid">
              <div class="skill-group">
                <h3 class="skill-group-title">主要技术</h3>
                <div class="skill-tags">
                  <span class="skill-tag">TypeScript</span>
                  <span class="skill-tag">Python</span>
                  <span class="skill-tag">Vue / React</span>
                  <span class="skill-tag">Astro</span>
                </div>
              </div>
              <div class="skill-group">
                <h3 class="skill-group-title">产品与交付</h3>
                <div class="skill-tags">
                  <span class="skill-tag">FastAPI</span>
                  <span class="skill-tag">PostgreSQL / Redis</span>
                  <span class="skill-tag">Browser CDP</span>
                  <span class="skill-tag">npm / PyPI</span>
                </div>
              </div>
              <div class="skill-group">
                <h3 class="skill-group-title">当前主题</h3>
                <div class="skill-tags">
                  <span class="skill-tag">开发期可观测性</span>
                  <span class="skill-tag">浏览器自动化</span>
                  <span class="skill-tag">AI 工作流</span>
                  <span class="skill-tag">产品演示视频</span>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-9);
    align-items: start;
  }

  /* --- Identity --- */
  .about-identity {
    position: sticky;
    top: 80px;
  }

  .avatar-wrap {
    margin-bottom: var(--space-4);
  }

  .avatar {
    width: 72px;
    height: 72px;
    background: var(--text-primary);
    color: var(--bg-primary);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .about-name {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }

  .about-tagline {
    font-size: 0.9375rem;
    margin-bottom: var(--space-5);
  }

  /* --- Content --- */
  .about-section {
    margin-bottom: var(--space-7);
  }
  .about-section:last-child {
    margin-bottom: 0;
  }

  .about-section h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .about-section p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* --- Skills --- */
  .skill-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-group-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-tag {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    padding: 4px 10px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .about-identity {
      position: static;
    }
  }
</style>
