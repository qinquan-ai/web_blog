---
import Base from "../ui/layouts/Base.astro";
import Button from "../ui/components/Button/Button.astro";
import IconArrowRight from "../ui/icons/IconArrowRight.astro";
import { SITE, SPONSOR } from "../lib/config";

const hasSponsorChannel = Boolean(SPONSOR.afdian || SPONSOR.github);
---

<Base title="支持" description={`支持 ${SITE.title} 的开源工具与技术内容`}>
  <div class="sponsor-page">
    <div class="container sponsor-container">
      <header class="sponsor-head">
        <p class="sponsor-eyebrow">随缘支持</p>
        <h1>觉得有用，就支持一下</h1>
        <p class="sponsor-copy">
          我会继续做开源工具、产品实验和工程写作。要是刚好帮到了你，
          可以随手支持一点，让我赚点零花钱。
        </p>
        {
          hasSponsorChannel ? (
            <div class="channel-actions">
              {SPONSOR.afdian && (
                <Button
                  href={SPONSOR.afdian}
                  target="_blank"
                  rel="noopener noreferrer"
                  size="lg"
                >
                  去爱发电支持
                  <IconArrowRight slot="icon-right" size={16} />
                </Button>
              )}
              {SPONSOR.github && (
                <Button
                  href={SPONSOR.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  size="lg"
                  variant="outline"
                >
                  通过 GitHub Sponsors 支持
                  <IconArrowRight slot="icon-right" size={16} />
                </Button>
              )}
            </div>
          ) : (
            <p class="channel-pending">
              爱发电主页正在配置中。赞助入口开放后，本页地址不会变化。
            </p>
          )
        }
        <p class="sponsor-note">
          完全自愿，量力而行；不附带功能优先级或商业服务。
        </p>
      </header>
    </div>
  </div>
</Base>

<style>
  .sponsor-page {
    padding: var(--space-12) 0 var(--space-16);
  }

  .sponsor-container {
    max-width: 760px;
  }

  .sponsor-head {
    padding-bottom: var(--space-8);
  }

  .sponsor-eyebrow {
    margin-bottom: var(--space-3);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .sponsor-head h1 {
    margin-bottom: var(--space-4);
    font-size: 2.5rem;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .sponsor-copy {
    max-width: 640px;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .channel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .sponsor-note,
  .channel-pending {
    margin-top: var(--space-6);
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .channel-pending {
    padding-left: var(--space-4);
    border-left: 2px solid var(--text-tertiary);
  }

  @media (max-width: 640px) {
    .sponsor-page {
      padding-top: var(--space-7);
    }

    .sponsor-head h1 {
      font-size: 1.875rem;
    }

    .channel-actions,
    :global(.sponsor-cta) {
      width: 100%;
    }
  }
</style>
