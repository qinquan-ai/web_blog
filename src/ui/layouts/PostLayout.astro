---
import Base from "./Base.astro";
import Button from "../components/Button/Button.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import IconArrowLeft from "../icons/IconArrowLeft.astro";
import Giscus from "../../components/Giscus.astro";
import ShareButton from "../../components/ShareButton.astro";
import ViewCounter from "../../components/ViewCounter.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import PostNav from "../../components/PostNav.astro";
import EditPost from "../../components/EditPost.astro";
import { TAGS, SITE, isPostVisible } from "../../lib/config";
import { formatDateFull } from "../../lib/utils";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "./post-layout.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: string;
  slug?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
  post?: CollectionEntry<"blog">;
}

const {
  title,
  description,
  image,
  pubDate,
  updatedDate,
  tags = [],
  readingTime = "5 min",
  slug,
  headings = [],
  prevPost = null,
  nextPost = null,
  post,
} = Astro.props;

const formattedDate = formatDateFull(pubDate);

const tagData = tags.map(t => TAGS.find(tag => tag.slug === t)).filter(Boolean);

const hasToC = headings.filter(h => h.depth === 2 || h.depth === 3).length > 0;

const allPosts = await getCollection("blog", isPostVisible);
const relatedPosts = allPosts
  .filter(p => p.slug !== slug)
  .filter(p => p.data.tags?.some((t: string) => tags.includes(t)))
  .sort((a, b) => {
    const dateA = a.data.pubDate.valueOf();
    const dateB = b.data.pubDate.valueOf();
    return (
      Math.abs(dateA - pubDate.valueOf()) - Math.abs(dateB - pubDate.valueOf())
    );
  })
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString() ?? pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.url,
  },
  description,
  url: new URL(Astro.url.pathname, SITE.url).href,
  inLanguage: "zh-CN",
  isAccessibleForFree: true,
};
---

<Base title={title} description={description} image={image} type="article">
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  <div class="reading-progress" id="reading-progress"></div>
  <article class="post-layout">
    <div class="container">
      <Breadcrumb
        crumbs={[
          { label: "首页", href: "/" },
          { label: "文章", href: "/blog" },
          { label: title, href: "#" },
        ]}
      />

      <header class="post-header">
        <div class="post-tags">
          {
            tagData.map(tag => (
              <a href={`/tags/${tag!.slug}`} class="tag-chip">
                {tag!.name}
              </a>
            ))
          }
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>

        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span class="meta-sep">·</span>
          <span>{readingTime}</span>
          {
            slug && (
              <>
                <span class="meta-sep">·</span>
                <ViewCounter slug={slug} />
              </>
            )
          }
          {
            post && (
              <>
                <span class="meta-sep">·</span>
                <EditPost post={post} />
              </>
            )
          }
        </div>
      </header>

      <div class="post-content-wrapper">
        <div class="post-content prose" data-pagefind-body>
          <slot />
        </div>

        {
          hasToC && (
            <>
              <aside class="post-sidebar" data-pagefind-ignore>
                <TableOfContents headings={headings} />
              </aside>
              <div class="toc-fab-wrapper">
                <button class="toc-fab" id="toc-fab" aria-label="目录">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="15" y2="12" />
                    <line x1="3" y1="18" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <div class="toc-drawer" id="toc-drawer" aria-hidden="true">
                <div class="toc-drawer-backdrop" id="toc-drawer-backdrop" />
                <div class="toc-drawer-panel">
                  <div class="toc-drawer-header">
                    <span class="toc-drawer-title">目录</span>
                    <button
                      class="toc-drawer-close"
                      id="toc-drawer-close"
                      aria-label="关闭"
                    >
                      ✕
                    </button>
                  </div>
                  <TableOfContents headings={headings} />
                </div>
              </div>
            </>
          )
        }
      </div>
      <div class="post-content-footer-spacer"></div>

      <PostNav prev={prevPost} next={nextPost} />
      <Giscus />

      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-label="相关文章">
            <h2 class="related-title">相关文章</h2>
            <ul class="related-list">
              {relatedPosts.map(p => (
                <li>
                  <a href={`/blog/${p.slug}`} class="related-link">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav class="post-footer-nav">
        <Button href="/blog" variant="ghost" size="sm" class="back-btn-ui">
          <IconArrowLeft slot="icon-left" />
          返回文章列表
        </Button>
        <ShareButton />
      </nav>
    </div>
  </article>
  <script>
    import { initReadingProgress, initTocDrawer, addHeadingLinks } from "./post-layout";
    document.addEventListener("astro:page-load", () => {
      initReadingProgress();
      initTocDrawer();
      addHeadingLinks();
    });
    if (document.readyState !== "loading") {
      initReadingProgress();
      initTocDrawer();
      addHeadingLinks();
    }
  </script>
</Base>

<style>
  .post-layout {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }
</style>
