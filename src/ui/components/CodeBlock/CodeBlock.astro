---
/**
 * CodeBlock 原语入口（Astro 文件）。
 *
 * 这里只挂一份 CSS 到全局 ——
 * 因为双主题实际样式由 Shiki 生成内联 span，
 * 真正的 <pre> 不需要 Astro 组件直接渲染。
 *
 * rehype 插件负责在 build 时：
 *   1. 给 Shiki 输出的 <pre> 包 .code-block 容器；
 *   2. 在容器内注入一个 <button class="code-copy">。
 *
 * 该文件存在的目的：
 *   - 让 Astro bundler 收集 CodeBlock.css；
 *   - 给未来"按 prop 控制 code block 主题/语言/标题"留一个挂载点。
 */
import './CodeBlock.css';

interface Props {
  /** 预留：以后可手动传 className 覆盖默认容器样式 */
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!-- 占位节点：MDX/markdown 渲染出来的 <pre> 由 rehype 改写；
     该占位用于测试时手动嵌入或调试。 -->
<pre class:list={['code-block-placeholder', className]}>
  <slot />
</pre>

<style>
  .code-block-placeholder { display: none; }
</style>
