---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑导航">
  <ol class="breadcrumb-list">
    {
      crumbs.map((crumb, i) => (
        <li class="breadcrumb-item">
          {i > 0 && (
            <span class="breadcrumb-sep" aria-hidden="true">
              /
            </span>
          )}
          {i === crumbs.length - 1 ? (
            <span class="breadcrumb-current" aria-current="page">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href} class="breadcrumb-link">
              {crumb.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .breadcrumb-sep {
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .breadcrumb-link:hover {
    color: var(--text-primary);
  }

  .breadcrumb-current {
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }
</style>
