---
/**
 * PageHeader — 页面标题区
 *
 * 样式：PageHeader.css
 * 用法：
 *   <PageHeader title="想法" desc="一些零碎想法…">
 *     <Fragment slot="actions"><a class="btn-secondary">…</a></Fragment>
 *   </PageHeader>
 *   或直接 <header class="page-header"><h1 class="page-title">…</h1>…</header>
 */
import './PageHeader.css';
interface Props {
  title: string;
  desc?: string;
}
const { title, desc } = Astro.props;
---

<header class="page-header">
  <div class="page-header-text">
    <h1 class="page-title">{title}</h1>
    {desc && <p class="page-desc">{desc}</p>}
  </div>
  <div class="page-header-actions">
    <slot name="actions" />
  </div>
</header>