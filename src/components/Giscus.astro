---
import Button from './ui/Button.astro';
---

<section class="comments-section">
  <div id="comments-loader" class="comments-loader">
    <Button id="load-comments-btn" variant="secondary" size="lg">
      <svg slot="icon-left" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
      查看评论
    </Button>
  </div>
  
  <div id="comments-container" class="comments-container hidden"></div>
</section>

<script is:inline>
  function initGiscusLoading() {
    const btn = document.getElementById('load-comments-btn');
    if (!btn) return;

    btn.onclick = function() {
      const container = document.getElementById('comments-container');
      const loader = document.getElementById('comments-loader');
      
      if (!container || !loader) return;

      // 使用组件内置的 Loading 状态模拟
      btn.classList.add('is-loading');
      btn.disabled = true;

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'qin16778/qin16778.github.io');
      script.setAttribute('data-repo-id', 'R_kgDON-oRBA');
      script.setAttribute('data-category', 'Announcements');
      script.setAttribute('data-category-id', 'DIC_kwDON-oRBM4CniP5');
      script.setAttribute('data-mapping', 'pathname');
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'top');
      script.setAttribute('data-theme', document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
      script.setAttribute('data-lang', 'zh-CN');
      script.setAttribute('data-loading', 'lazy');
      script.crossOrigin = 'anonymous';
      script.async = true;

      script.onload = () => {
        loader.style.display = 'none';
        container.classList.remove('hidden');
      };

      container.appendChild(script);
    };
  }

  document.addEventListener('astro:page-load', initGiscusLoading);
  initGiscusLoading();
</script>

<style>
  .comments-section {
    margin: var(--space-9) 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-light);
  }

  .comments-loader {
    display: flex;
    justify-content: center;
    padding: var(--space-4) 0;
  }

  .comments-container.hidden {
    display: none;
  }
</style>
