---
import Button from "../ui/components/Button.astro";

interface Props {
  title?: string;
}

const { title = "分享文章" } = Astro.props;
---

<Button
  id="share-btn"
  variant="primary"
  size="sm"
>
  <svg
    slot="icon-left"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-share-2"
  >
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
    <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
  </svg>
  <span id="share-text">{title}</span>
</Button>

<script>
  const btn = document.getElementById("share-btn");
  const text = document.getElementById("share-text");

  if (btn && text) {
    btn.addEventListener("click", async () => {
      try {
        // 直接使用剪贴板复制，更适合 PC 端体验
        await navigator.clipboard.writeText(window.location.href);

        const originalText = text.innerText;
        text.innerText = "已复制链接";
        btn.classList.add("copied");

        setTimeout(() => {
          text.innerText = originalText;
          btn.classList.remove("copied");
        }, 2000);
      } catch (err) {
        // eslint-disable-next-line no-console
        console.error("复制链接失败:", err);
        // 如果剪贴板 API 失败，提供一个降级方案
        const input = document.createElement("input");
        input.value = window.location.href;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        document.body.removeChild(input);

        const originalText = text.innerText;
        text.innerText = "已复制链接";
        btn.classList.add("copied");
        setTimeout(() => {
          text.innerText = originalText;
          btn.classList.remove("copied");
        }, 2000);
      }
    });
  }
</script>

<style>
  :global(#share-btn.copied) {
    color: #10b981 !important; /* Tailwind emerald-500 */
    border-color: #10b981 !important;
    background: rgba(16, 185, 129, 0.08) !important;
  }
</style>
