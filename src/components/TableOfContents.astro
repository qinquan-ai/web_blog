---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
// Filter to h2 and h3
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav class="toc">
    <h3 class="toc-title">目录</h3>
    <ul class="toc-list">
      {toc.map(heading => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initToc() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            document.querySelectorAll('.toc-link').forEach((link) => {
              link.classList.remove('active');
            });
            const id = entry.target.getAttribute('id');
            if (id) {
              const link = document.querySelector(`.toc-link[data-slug="${id}"]`);
              if (link) link.classList.add('active');
            }
          }
        });
      },
      { rootMargin: '0px 0px -80% 0px' }
    );

    document.querySelectorAll('.prose h2, .prose h3').forEach((section) => {
      observer.observe(section);
    });
  }

  document.addEventListener('astro:page-load', initToc);
  if (document.readyState !== 'loading') initToc();
</script>

<style>
  .toc {
    position: sticky;
    top: var(--space-8);
    font-size: 0.875rem;
    padding-left: var(--space-4);
    border-left: 1px solid var(--border-light);
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-item {
    margin-bottom: var(--space-2);
  }
  .toc-item.depth-3 {
    padding-left: var(--space-3);
  }
  .toc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast);
    display: block;
    line-height: 1.5;
  }
  .toc-link:hover,
  .toc-link.active {
    color: var(--text-primary);
  }
  .toc-link.active {
    font-weight: 500;
  }
</style>
