---
import Base from './Base.astro';
import Button from '../components/ui/Button.astro';
import BackLink from '../components/BackLink.astro';
import IconArrowLeft from '../components/icons/IconArrowLeft.astro';
import Giscus from '../components/Giscus.astro';
import ShareButton from '../components/ShareButton.astro';
import ViewCounter from '../components/ViewCounter.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostNav from '../components/PostNav.astro';
import CodeCopy from '../components/CodeCopy.astro';
import { TAGS } from '../lib/config';
import { formatDateFull } from '../lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: string;
  slug?: string;
  headings?: any[];
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
}

const { title, description, pubDate, tags = [], readingTime = '5 min', slug, headings = [], prevPost = null, nextPost = null } = Astro.props;

const formattedDate = formatDateFull(pubDate);

const tagData = tags
  .map(t => TAGS.find(tag => tag.slug === t))
  .filter(Boolean);

// Only show ToC if there are H2 or H3 headings
const hasToC = headings.filter(h => h.depth === 2 || h.depth === 3).length > 0;
---

<Base title={title} description={description} type="article">
  <article class="post-layout">
    <div class="container">
      <!-- Back link -->
      <BackLink href="/blog" label="文章列表" />

      <!-- Header -->
      <header class="post-header">
        <div class="post-tags">
          {tagData.map(tag => (
            <a href={`/tags/${tag!.slug}`} class="tag-chip">
              {tag!.name}
            </a>
          ))}
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>

        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span class="meta-sep">·</span>
          <span>{readingTime}</span>
          {slug && (
            <>
              <span class="meta-sep">·</span>
              <ViewCounter slug={slug} />
            </>
          )}
        </div>
      </header>

      <!-- Content -->
      <div class="post-content-wrapper">
        <div class="post-content prose">
          <slot />
        </div>

        {hasToC && (
          <aside class="post-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>

      <!-- Next/Prev Nav -->
      <PostNav prev={prevPost} next={nextPost} />

      <!-- Comments -->
      <Giscus />

      <!-- Footer nav -->
      <nav class="post-footer-nav">
        <Button href="/blog" variant="ghost" size="sm" class="back-btn-ui">
          <IconArrowLeft slot="icon-left" />
          返回文章列表
        </Button>
        <ShareButton />
      </nav>
    </div>
  </article>
  <CodeCopy />
</Base>

<style>
  .post-layout {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .post-content-wrapper {
    position: relative;
  }

  .post-sidebar {
    display: none;
  }

  @media (min-width: 1200px) {
    .post-sidebar {
      display: block;
      position: absolute;
      left: calc(100% + var(--space-8));
      top: 0;
      width: 240px;
    }
  }

  /* back-link margin override for detail page */
  .post-layout :global(.back-link) {
    margin-bottom: var(--space-7);
  }

  .post-header {
    margin-bottom: var(--space-7);
    text-align: center;
  }

  .post-tags {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-3);
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .meta-sep {
    color: var(--border);
  }

  .post-content {
    margin-bottom: var(--space-8);
  }

  .post-footer-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-7);
    margin-top: var(--space-8);
    border-top: 1px solid var(--border-light);
  }

  .back-btn-ui :global(svg) {
    transition: transform var(--duration-fast);
  }

  .back-btn-ui:hover :global(svg) {
    transform: translateX(-3px);
  }

  /* Prose Overrides */
  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
    scroll-margin-top: 80px;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    scroll-margin-top: 80px;
  }

  .prose :global(h4) {
    font-size: 1.125rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
    scroll-margin-top: 80px;
  }

  .prose :global(p) {
    margin-bottom: var(--space-5);
  }

  .prose :global(img) {
    border-radius: var(--radius-lg);
    margin: var(--space-7) 0;
    box-shadow: var(--shadow-md);
  }

  /* Post Nav Section */
  :global(.post-nav) {
    margin-bottom: var(--space-8);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  :global(.giscus) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
</style>