---
import Base from "./Base.astro";
import Button from "../ui/components/Button.astro";
import Breadcrumb from "../ui/components/Breadcrumb.astro";
import IconArrowLeft from "../ui/icons/IconArrowLeft.astro";
import Giscus from "../components/Giscus.astro";
import ShareButton from "../components/ShareButton.astro";
import ViewCounter from "../components/ViewCounter.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostNav from "../components/PostNav.astro";
import EditPost from "../components/EditPost.astro";
import { TAGS, SITE } from "../lib/config";
import { formatDateFull } from "../lib/utils";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: string;
  slug?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
  post?: CollectionEntry<"blog">;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  readingTime = "5 min",
  slug,
  headings = [],
  prevPost = null,
  nextPost = null,
  post,
} = Astro.props;

const formattedDate = formatDateFull(pubDate);

const tagData = tags.map(t => TAGS.find(tag => tag.slug === t)).filter(Boolean);

// Only show ToC if there are H2 or H3 headings
const hasToC = headings.filter(h => h.depth === 2 || h.depth === 3).length > 0;

const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter(p => p.slug !== slug)
  .filter(p => p.data.tags?.some((t: string) => tags.includes(t)))
  .sort((a, b) => {
    const dateA = a.data.pubDate.valueOf();
    const dateB = b.data.pubDate.valueOf();
    return Math.abs(dateA - pubDate.valueOf()) - Math.abs(dateB - pubDate.valueOf());
  })
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString() ?? pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.url,
  },
  description: description,
  url: new URL(Astro.url.pathname, SITE.url).href,
  inLanguage: "zh-CN",
  isAccessibleForFree: true,
};
---

<Base title={title} description={description} type="article">
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  <div class="reading-progress" id="reading-progress"></div>
  <article class="post-layout">
      <div class="container">
      <!-- Breadcrumb -->
      <Breadcrumb
        crumbs={[
          { label: "首页", href: "/" },
          { label: "文章", href: "/blog" },
          { label: title, href: "#" },
        ]}
      />

      <!-- Header -->
      <header class="post-header">
        <div class="post-tags">
          {
            tagData.map(tag => (
              <a href={`/tags/${tag!.slug}`} class="tag-chip">
                {tag!.name}
              </a>
            ))
          }
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>

        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span class="meta-sep">·</span>
          <span>{readingTime}</span>
          {
            slug && (
              <>
                <span class="meta-sep">·</span>
                <ViewCounter slug={slug} />
              </>
            )
          }
          {
            post && (
              <>
                <span class="meta-sep">·</span>
                <EditPost post={post} />
              </>
            )
          }
        </div>
      </header>

      <!-- Content -->
      <div class="post-content-wrapper">
        <div class="post-content prose" data-pagefind-body>
          <slot />
        </div>

        {
          hasToC && (
            <>
              <aside class="post-sidebar" data-pagefind-ignore>
                <TableOfContents headings={headings} />
              </aside>
              <div class="toc-fab-wrapper">
                <button class="toc-fab" id="toc-fab" aria-label="目录">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="15" y2="12" />
                    <line x1="3" y1="18" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <div class="toc-drawer" id="toc-drawer" aria-hidden="true">
                <div class="toc-drawer-backdrop" id="toc-drawer-backdrop" />
                <div class="toc-drawer-panel">
                  <div class="toc-drawer-header">
                    <span class="toc-drawer-title">目录</span>
                    <button
                      class="toc-drawer-close"
                      id="toc-drawer-close"
                      aria-label="关闭"
                    >
                      ✕
                    </button>
                  </div>
                  <TableOfContents headings={headings} />
                </div>
              </div>
            </>
          )
        }
      </div>
      <div class="post-content-footer-spacer" />

      <!-- Next/Prev Nav -->
      <PostNav prev={prevPost} next={nextPost} />

      <!-- Comments -->
      <Giscus />

      <!-- Related Posts -->
      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-label="相关文章">
            <h2 class="related-title">相关文章</h2>
            <ul class="related-list">
              {relatedPosts.map(p => (
                <li>
                  <a href={`/blog/${p.slug}`} class="related-link">
                    {p.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Footer nav -->
      <nav class="post-footer-nav">
        <Button href="/blog" variant="ghost" size="sm" class="back-btn-ui">
          <IconArrowLeft slot="icon-left" />
          返回文章列表
        </Button>
        <ShareButton />
      </nav>
    </div>
  </article>
  <script>
    function initReadingProgress() {
      const bar = document.getElementById("reading-progress");
      if (!bar) return;
      const update = () => {
        const scrollTop = window.scrollY;
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        bar.style.width = progress + "%";
      };
      window.addEventListener("scroll", update, { passive: true });
      update();
    }

    function addHeadingLinks() {
      const headings = document.querySelectorAll(
        ".prose h2, .prose h3, .prose h4"
      );
      headings.forEach(heading => {
        if (!heading.id) return;
        const anchor = document.createElement("a");
        anchor.href = "#" + heading.id;
        anchor.className = "heading-anchor";
        anchor.setAttribute("aria-label", "链接到本节");
        anchor.textContent = "#";
        heading.appendChild(anchor);
      });
    }

    function initTocDrawer() {
      const fab = document.getElementById("toc-fab");
      const drawer = document.getElementById("toc-drawer");
      const backdrop = document.getElementById("toc-drawer-backdrop");
      const closeBtn = document.getElementById("toc-drawer-close");
      if (!fab || !drawer) return;

      const open = () => {
        if (window.innerWidth >= 1100) return;
        drawer.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        drawer.classList.remove("is-open");
        drawer.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      fab.addEventListener("click", open);
      backdrop?.addEventListener("click", close);
      closeBtn?.addEventListener("click", close);

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1100 && drawer.classList.contains("is-open")) {
          close();
        }
      });
    }

    document.addEventListener("astro:page-load", () => {
      initReadingProgress();
      initTocDrawer();
      addHeadingLinks();
    });
    if (document.readyState !== "loading") {
      initReadingProgress();
      initTocDrawer();
      addHeadingLinks();
    }
  </script>
</Base>

<style>
  .post-layout {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--accent);
    z-index: 200;
    transition: width 50ms linear;
  }

  .post-content-wrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .post-content {
    flex: 1;
    max-width: var(--content-max);
    min-width: 0;
  }

  .post-sidebar {
    display: none;
    flex-shrink: 0;
    width: 240px;
  }

  .post-content-footer-spacer {
    display: none;
  }

  @media (min-width: 1200px) {
    .post-content-wrapper {
      width: calc(var(--content-max) + var(--space-8) + 240px);
      margin-left: auto;
      margin-right: auto;
    }

    .post-sidebar {
      display: block;
      position: sticky;
      top: var(--space-8);
      align-self: flex-start;
    }
    .toc-fab-wrapper {
      display: none;
    }
    .toc-drawer {
      display: none !important;
    }
  }

  /* Mobile FAB */
  @media (max-width: 1099px) {
    .toc-fab-wrapper {
      position: fixed;
      bottom: var(--space-6);
      right: var(--space-6);
      z-index: 50;
      margin-bottom: 0;
    }
  }

  .toc-fab {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast);
    box-shadow: var(--shadow-sm);
  }

  .toc-fab:hover {
    background: var(--bg-primary);
    color: var(--text-primary);
    border-color: var(--border);
    transform: scale(1.05);
  }

  /* Mobile Drawer */
  .toc-drawer {
    display: none;
  }

  .toc-drawer.is-open {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 500;
  }

  .toc-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
  }

  .toc-drawer-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-primary);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: var(--space-5);
    max-height: 60vh;
    overflow-y: auto;
    animation: slide-up 0.25s var(--ease-out);
  }

  @keyframes slide-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .toc-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .toc-drawer-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .toc-drawer-close {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    font-size: 0.875rem;
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast);
  }

  .toc-drawer-close:hover {
    color: var(--text-primary);
  }

  .toc-drawer .toc {
    position: static;
    border-left: none;
    padding-left: 0;
  }

  .toc-drawer .toc-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .toc-drawer .toc-link:hover {
    background: var(--bg-secondary);
  }

  /* Mobile TOC list inside drawer */
  .toc-drawer .toc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-header {
    margin-bottom: var(--space-7);
    text-align: center;
  }

  .post-tags {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-3);
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .meta-sep {
    color: var(--border);
  }

  .post-content {
    margin-bottom: var(--space-8);
  }

  .post-footer-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-5);
    margin-top: 0;
    border-top: 1px solid var(--border-light);
  }

  .back-btn-ui :global(svg) {
    transition: transform var(--duration-fast);
  }

  .back-btn-ui:hover :global(svg) {
    transform: translateX(-3px);
  }

  /* Prose Overrides */
  .prose :global(h2) {
    font-size: 1.75rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
    scroll-margin-top: 80px;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    position: relative;
  }

  :global(.heading-anchor) {
    position: absolute;
    left: -1.5em;
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 0.85em;
    opacity: 0;
    transition: opacity 150ms ease;
    user-select: none;
  }

  :global(.prose h2:hover .heading-anchor),
  :global(.prose h3:hover .heading-anchor),
  :global(.prose h4:hover .heading-anchor),
  :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    scroll-margin-top: 80px;
  }

  .prose :global(h4) {
    font-size: 1.125rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
    scroll-margin-top: 80px;
  }

  .prose :global(p) {
    margin-bottom: var(--space-5);
  }

  .prose :global(img) {
    border-radius: var(--radius-lg);
    margin: var(--space-7) 0;
    box-shadow: var(--shadow-md);
  }

  .prose :global(figure.book-cover) {
    text-align: center;
    margin: var(--space-8) 0;
  }

  .prose :global(figure.book-cover img) {
    display: inline-block;
    max-width: 280px;
    width: 100%;
    margin: 0 auto var(--space-3);
    box-shadow: var(--shadow-md);
  }

  .prose :global(figcaption) {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* Post Nav Section */
  :global(.post-nav) {
    margin-bottom: 0px;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  :global(.giscus) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }

  /* Related Posts */
  .related-posts {
    margin-top: var(--space-8);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-light);
  }

  .related-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .related-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.9375rem;
    border: 1px solid var(--border-light);
    background: var(--bg-secondary);
    transition: all var(--duration-fast);
  }

  .related-link:hover {
    border-color: var(--accent);
    background: var(--bg-primary);
    transform: translateX(4px);
  }
</style>
